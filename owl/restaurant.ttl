@prefix : <http://example.org/kr25/restaurant#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/kr25/restaurant#> .

<http://example.org/kr25/restaurant> rdf:type owl:Ontology ;
                                      rdfs:label "Hotel Restaurant Menu Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/kr25/restaurant#hasCuisine
:hasCuisine rdf:type owl:ObjectProperty ;
            rdfs:domain :Restaurant ;
            rdfs:range :Cuisine .


#################################################################
#    Data properties
#################################################################

###  http://example.org/kr25/restaurant#closesAt
:closesAt rdf:type owl:DatatypeProperty ;
          rdfs:domain :Restaurant ;
          rdfs:range xsd:integer .


###  http://example.org/kr25/restaurant#hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string .


###  http://example.org/kr25/restaurant#hasPublicAccess
:hasPublicAccess rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Restaurant ;
                 rdfs:range xsd:boolean .


###  http://example.org/kr25/restaurant#opensAt
:opensAt rdf:type owl:DatatypeProperty ;
         rdfs:domain :Restaurant ;
         rdfs:range xsd:integer .


###  http://example.org/kr25/restaurant#petsAllowed
:petsAllowed rdf:type owl:DatatypeProperty ;
             rdfs:domain :Restaurant ;
             rdfs:range xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://example.org/kr25/restaurant#Cuisine
:Cuisine rdf:type owl:Class .


###  http://example.org/kr25/restaurant#Restaurant
:Restaurant rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/kr25/restaurant#Grand_Dining_Room
:Grand_Dining_Room rdf:type owl:NamedIndividual ,
                            :Restaurant .


###  http://example.org/kr25/restaurant#Greek
:Greek rdf:type owl:NamedIndividual ,
                :Cuisine .


###  http://example.org/kr25/restaurant#Harbour_Grill
:Harbour_Grill rdf:type owl:NamedIndividual ,
                        :Restaurant ;
               :hasCuisine :Greek ;
               :closesAt 2300 ;
               :hasName "Harbour Grill" ;
               :hasPublicAccess "true"^^xsd:boolean ;
               :opensAt 1200 .


###  http://example.org/kr25/restaurant#Kebab_Corner
:Kebab_Corner rdf:type owl:NamedIndividual ,
                       :Restaurant .


