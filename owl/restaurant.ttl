@prefix : <http://example.org/kr25/restaurant#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/kr25/restaurant#> .

<http://example.org/kr25/restaurant> rdf:type owl:Ontology ;
                                      rdfs:label "Hotel Restaurant Menu Ontology" .

#################################################################
#    Object Properties
#################################################################

###  http://example.org/kr25/restaurant#containsAllergen
:containsAllergen rdf:type owl:ObjectProperty ;
                  rdfs:domain :Dish ;
                  rdfs:range :Allergen ;
                  owl:propertyChainAxiom ( :hasIngredient
                                           :hasAllergen
                                         ) .


###  http://example.org/kr25/restaurant#hasAllergen
:hasAllergen rdf:type owl:ObjectProperty ;
             rdfs:domain :Ingredient ;
             rdfs:range :Allergen .


###  http://example.org/kr25/restaurant#hasCuisine
:hasCuisine rdf:type owl:ObjectProperty ;
            rdfs:domain :Restaurant ;
            rdfs:range :Cuisine .


###  http://example.org/kr25/restaurant#hasIngredient
:hasIngredient rdf:type owl:ObjectProperty ;
               owl:inverseOf :ingredientOf ;
               rdfs:domain :Dish ;
               rdfs:range :Ingredient .


###  http://example.org/kr25/restaurant#ingredientCategory
:ingredientCategory rdf:type owl:ObjectProperty ;
                    rdfs:domain :Ingredient ;
                    rdfs:range :IngredientCategory .


###  http://example.org/kr25/restaurant#ingredientOf
:ingredientOf rdf:type owl:ObjectProperty .


###  http://example.org/kr25/restaurant#satisfiesDiet
:satisfiesDiet rdf:type owl:ObjectProperty ;
               rdfs:domain :Dish ;
               rdfs:range :DietaryRestriction .


###  http://example.org/kr25/restaurant#servedBy
:servedBy rdf:type owl:ObjectProperty ;
          owl:inverseOf :servesDish .


###  http://example.org/kr25/restaurant#servesCheap
:servesCheap rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :servesDish .


###  http://example.org/kr25/restaurant#servesDish
:servesDish rdf:type owl:ObjectProperty ;
            rdfs:domain :Restaurant ;
            rdfs:range :Dish .


###  http://example.org/kr25/restaurant#servesExpensive
:servesExpensive rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :servesDish .


###  http://example.org/kr25/restaurant#servesMedium
:servesMedium rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :servesDish .


###  http://example.org/kr25/restaurant#slaughterMethod
:slaughterMethod rdf:type owl:ObjectProperty ;
                 rdfs:domain :Ingredient ;
                 rdfs:range :SlaughterMethod .


#################################################################
#    Data properties
#################################################################

###  http://example.org/kr25/restaurant#closesAt
:closesAt rdf:type owl:DatatypeProperty ;
          rdfs:domain :Restaurant ;
          rdfs:range xsd:integer .


###  http://example.org/kr25/restaurant#gramsOfCarbs
:gramsOfCarbs rdf:type owl:DatatypeProperty ;
              rdfs:domain :Dish ;
              rdfs:range xsd:integer .


###  http://example.org/kr25/restaurant#gramsOfFat
:gramsOfFat rdf:type owl:DatatypeProperty ;
            rdfs:domain :Dish ;
            rdfs:range xsd:integer .


###  http://example.org/kr25/restaurant#gramsOfProtein
:gramsOfProtein rdf:type owl:DatatypeProperty ;
                rdfs:domain :Dish ;
                rdfs:range xsd:integer .


###  http://example.org/kr25/restaurant#hasName
:hasName rdf:type owl:DatatypeProperty ;
         rdfs:range xsd:string .


###  http://example.org/kr25/restaurant#hasPublicAccess
:hasPublicAccess rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Restaurant ;
                 rdfs:range xsd:boolean .


###  http://example.org/kr25/restaurant#lgbtqFriendly
:lgbtqFriendly rdf:type owl:DatatypeProperty ;
               rdfs:domain :Restaurant ;
               rdfs:range xsd:boolean .


###  http://example.org/kr25/restaurant#opensAt
:opensAt rdf:type owl:DatatypeProperty ;
         rdfs:domain :Restaurant ;
         rdfs:range xsd:integer .


###  http://example.org/kr25/restaurant#ownerGender
:ownerGender rdf:type owl:DatatypeProperty ;
             rdfs:domain :Restaurant ;
             rdfs:range xsd:string .


###  http://example.org/kr25/restaurant#petsAllowed
:petsAllowed rdf:type owl:DatatypeProperty ;
             rdfs:domain :Restaurant ;
             rdfs:range xsd:boolean .


#################################################################
#    Classes
#################################################################

###  http://example.org/kr25/restaurant#Allergen
:Allergen rdf:type owl:Class .


###  http://example.org/kr25/restaurant#AllergenContainingDish
:AllergenContainingDish rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :containsAllergen ;
                                                                     owl:someValuesFrom :Allergen
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] .


###  http://example.org/kr25/restaurant#AllergenicIngredient
:AllergenicIngredient rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :hasAllergen ;
                                                                   owl:someValuesFrom :Allergen
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] .


###  http://example.org/kr25/restaurant#AnimalDerivedIngredient
:AnimalDerivedIngredient rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:unionOf ( :DairyIngredient
                                                             :EggIngredient
                                                             :FishIngredient
                                                             :MeatIngredient
                                                             :ShellfishIngredient
                                                             [ owl:intersectionOf ( :Ingredient
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty :ingredientCategory ;
                                                                                      owl:hasValue :Honey_Category
                                                                                    ]
                                                                                  ) ;
                                                               rdf:type owl:Class
                                                             ]
                                                           )
                                             ] .


###  http://example.org/kr25/restaurant#AnimalProductContainingDish
:AnimalProductContainingDish rdf:type owl:Class ;
                             owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty :hasIngredient ;
                                                                          owl:someValuesFrom :AnimalDerivedIngredient
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ] .


###  http://example.org/kr25/restaurant#Buffet
:Buffet rdf:type owl:Class ;
        rdfs:subClassOf :Restaurant .


###  http://example.org/kr25/restaurant#Cafe
:Cafe rdf:type owl:Class ;
      rdfs:subClassOf :Restaurant .


###  http://example.org/kr25/restaurant#Casual_Restaurant
:Casual_Restaurant rdf:type owl:Class ;
                   rdfs:subClassOf :Restaurant .


###  http://example.org/kr25/restaurant#Cuisine
:Cuisine rdf:type owl:Class .


###  http://example.org/kr25/restaurant#DairyIngredient
:DairyIngredient rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :ingredientCategory ;
                                                              owl:hasValue :Dairy_Category
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


###  http://example.org/kr25/restaurant#DietaryRestriction
:DietaryRestriction rdf:type owl:Class .


###  http://example.org/kr25/restaurant#Dish
:Dish rdf:type owl:Class .


###  http://example.org/kr25/restaurant#EggIngredient
:EggIngredient rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :ingredientCategory ;
                                                            owl:hasValue :Egg_Category
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] .


###  http://example.org/kr25/restaurant#Fast_Food_Restaurant
:Fast_Food_Restaurant rdf:type owl:Class ;
                      rdfs:subClassOf :Restaurant .


###  http://example.org/kr25/restaurant#Fine_Dining_Restaurant
:Fine_Dining_Restaurant rdf:type owl:Class ;
                        rdfs:subClassOf :Restaurant .


###  http://example.org/kr25/restaurant#FishIngredient
:FishIngredient rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :ingredientCategory ;
                                                             owl:hasValue :Fish_Category
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] .


###  http://example.org/kr25/restaurant#FishOrShellfishDish
:FishOrShellfishDish rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :hasIngredient ;
                                                                  owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                       owl:unionOf ( :FishIngredient
                                                                                                     :ShellfishIngredient
                                                                                                   )
                                                                                     ]
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] .


###  http://example.org/kr25/restaurant#GlutenContainingDish
:GlutenContainingDish rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :containsAllergen ;
                                                                   owl:hasValue :Gluten_Allergen
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] .


###  http://example.org/kr25/restaurant#HalalSlaughterIngredient
:HalalSlaughterIngredient rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :slaughterMethod ;
                                                                       owl:hasValue :Halal_Slaughter
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] .


###  http://example.org/kr25/restaurant#HalalSuitableDish
:HalalSuitableDish rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :satisfiesDiet ;
                                                                owl:hasValue :Halal
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] .


###  http://example.org/kr25/restaurant#HighProteinDish
:HighProteinDish rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :gramsOfProtein ;
                                                              owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                   owl:onDatatype xsd:integer ;
                                                                                   owl:withRestrictions ( [ xsd:minInclusive 30
                                                                                                          ]
                                                                                                        )
                                                                                 ]
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


###  http://example.org/kr25/restaurant#Ingredient
:Ingredient rdf:type owl:Class .


###  http://example.org/kr25/restaurant#IngredientCategory
:IngredientCategory rdf:type owl:Class .


###  http://example.org/kr25/restaurant#KosherSlaughterIngredient
:KosherSlaughterIngredient rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty :slaughterMethod ;
                                                                        owl:hasValue :Kosher_Slaughter
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] .


###  http://example.org/kr25/restaurant#LowCarbDish
:LowCarbDish rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :gramsOfCarbs ;
                                                          owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                               owl:onDatatype xsd:integer ;
                                                                               owl:withRestrictions ( [ xsd:maxInclusive 10
                                                                                                      ]
                                                                                                    )
                                                                             ]
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .


###  http://example.org/kr25/restaurant#MeatContainingDish
:MeatContainingDish rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :hasIngredient ;
                                                                 owl:someValuesFrom :MeatIngredient
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] .


###  http://example.org/kr25/restaurant#MeatIngredient
:MeatIngredient rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :ingredientCategory ;
                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                  owl:oneOf ( :Beef_Category
                                                                                              :Lamb_Category
                                                                                              :Pork_Category
                                                                                              :Poultry_Category
                                                                                            )
                                                                                ]
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                owl:disjointWith :PlantIngredient .


###  http://example.org/kr25/restaurant#MilkAllergenContainingDish
:MilkAllergenContainingDish rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :containsAllergen ;
                                                                         owl:hasValue :Milk_Allergen
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] .


###  http://example.org/kr25/restaurant#OnlyPlantIngredientsDish
:OnlyPlantIngredientsDish rdf:type owl:Class ;
                          owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty :hasIngredient ;
                                                                       owl:allValuesFrom :PlantIngredient
                                                                     ]
                                                                   ) ;
                                                rdf:type owl:Class
                                              ] .


###  http://example.org/kr25/restaurant#PeanutContainingDish
:PeanutContainingDish rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty :containsAllergen ;
                                                                   owl:hasValue :Peanuts_Allergen
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] .


###  http://example.org/kr25/restaurant#PetFriendlyRestaurant
:PetFriendlyRestaurant rdf:type owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( :Restaurant
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :petsAllowed ;
                                                                    owl:hasValue "true"^^xsd:boolean
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] .


###  http://example.org/kr25/restaurant#PlantIngredient
:PlantIngredient rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :ingredientCategory ;
                                                              owl:hasValue :Plant_Category
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] .


###  http://example.org/kr25/restaurant#PublicRestaurant
:PublicRestaurant rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :Restaurant
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasPublicAccess ;
                                                               owl:hasValue "true"^^xsd:boolean
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] .


###  http://example.org/kr25/restaurant#Restaurant
:Restaurant rdf:type owl:Class .


###  http://example.org/kr25/restaurant#RestaurantServingHighProteinDish
:RestaurantServingHighProteinDish rdf:type owl:Class ;
                                  owl:equivalentClass [ owl:intersectionOf ( :Restaurant
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :servesDish ;
                                                                               owl:someValuesFrom :HighProteinDish
                                                                             ]
                                                                           ) ;
                                                        rdf:type owl:Class
                                                      ] .


###  http://example.org/kr25/restaurant#RestaurantServingVeganDish
:RestaurantServingVeganDish rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( :Restaurant
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty :servesDish ;
                                                                         owl:someValuesFrom :VeganSuitableDish
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] .


###  http://example.org/kr25/restaurant#RestaurantWithMultipleDishes
:RestaurantWithMultipleDishes rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( :Restaurant
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty :servesDish ;
                                                                           owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                           owl:onClass :Dish
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] .


###  http://example.org/kr25/restaurant#Seafood_Restaurant
:Seafood_Restaurant rdf:type owl:Class ;
                    rdfs:subClassOf :Restaurant .


###  http://example.org/kr25/restaurant#ShellfishIngredient
:ShellfishIngredient rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :Ingredient
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :ingredientCategory ;
                                                                  owl:hasValue :Shellfish_Category
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] .


###  http://example.org/kr25/restaurant#SlaughterMethod
:SlaughterMethod rdf:type owl:Class .


###  http://example.org/kr25/restaurant#VeganSuitableDish
:VeganSuitableDish rdf:type owl:Class ;
                   owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty :satisfiesDiet ;
                                                                owl:hasValue :Vegan
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] .


###  http://example.org/kr25/restaurant#VegetarianSuitableDish
:VegetarianSuitableDish rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :Dish
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :satisfiesDiet ;
                                                                     owl:hasValue :Vegetarian
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] .


#################################################################
#    Individuals
#################################################################

###  http://example.org/kr25/restaurant#Alcohol_Category
:Alcohol_Category rdf:type owl:NamedIndividual ,
                           :IngredientCategory ;
                  :hasName "alcohol" .


###  http://example.org/kr25/restaurant#Bacon
:Bacon rdf:type owl:NamedIndividual ,
                :Ingredient ;
       :ingredientCategory :Pork_Category ;
       :hasName "Bacon" .


###  http://example.org/kr25/restaurant#Beef
:Beef rdf:type owl:NamedIndividual ,
               :Ingredient ;
      :ingredientCategory :Beef_Category ;
      :hasName "Beef" .


###  http://example.org/kr25/restaurant#Beef_Burger
:Beef_Burger rdf:type owl:NamedIndividual ,
                      :Dish ;
             :hasIngredient :Beef ,
                            :Cheese ,
                            :Tomato ;
             :gramsOfCarbs 40 ;
             :gramsOfFat 28 ;
             :gramsOfProtein 30 ;
             :hasName "Beef Burger" .


###  http://example.org/kr25/restaurant#Beef_Category
:Beef_Category rdf:type owl:NamedIndividual ,
                        :IngredientCategory ;
               :hasName "beef" .


###  http://example.org/kr25/restaurant#Beef_Halal
:Beef_Halal rdf:type owl:NamedIndividual ,
                     :Ingredient ;
            :ingredientCategory :Beef_Category ;
            :slaughterMethod :Halal_Slaughter ;
            :hasName "Beef (halal)" .


###  http://example.org/kr25/restaurant#Beef_Stew
:Beef_Stew rdf:type owl:NamedIndividual ,
                    :Dish ;
           :hasIngredient :Beef_Halal ,
                          :Carrot ,
                          :Red_Wine ,
                          :Tomato ;
           :gramsOfCarbs 18 ;
           :gramsOfFat 15 ;
           :gramsOfProtein 30 ;
           :hasName "Beef Stew" .


###  http://example.org/kr25/restaurant#Broccoli
:Broccoli rdf:type owl:NamedIndividual ,
                   :Ingredient ;
          :ingredientCategory :Plant_Category ;
          :hasName "Broccoli" .


###  http://example.org/kr25/restaurant#Butter
:Butter rdf:type owl:NamedIndividual ,
                 :Ingredient ;
        :hasAllergen :Milk_Allergen ;
        :ingredientCategory :Dairy_Category ;
        :hasName "Butter" .


###  http://example.org/kr25/restaurant#Carbonara
:Carbonara rdf:type owl:NamedIndividual ,
                    :Dish ;
           :hasIngredient :Bacon ,
                          :Cheese ,
                          :Egg ,
                          :Wheat_Flour ;
           :gramsOfCarbs 55 ;
           :gramsOfFat 30 ;
           :gramsOfProtein 25 ;
           :hasName "Carbonara" .


###  http://example.org/kr25/restaurant#Carrot
:Carrot rdf:type owl:NamedIndividual ,
                 :Ingredient ;
        :ingredientCategory :Plant_Category ;
        :hasName "Carrot" .


###  http://example.org/kr25/restaurant#Celery
:Celery rdf:type owl:NamedIndividual ,
                 :Ingredient ;
        :hasAllergen :Celery_Allergen ;
        :ingredientCategory :Plant_Category ;
        :hasName "Celery" .


###  http://example.org/kr25/restaurant#Celery_Allergen
:Celery_Allergen rdf:type owl:NamedIndividual ,
                          :Allergen ;
                 :hasName "celery" .


###  http://example.org/kr25/restaurant#Cheese
:Cheese rdf:type owl:NamedIndividual ,
                 :Ingredient ;
        :hasAllergen :Milk_Allergen ;
        :ingredientCategory :Dairy_Category ;
        :hasName "Cheese" .


###  http://example.org/kr25/restaurant#Cheese_Omelette
:Cheese_Omelette rdf:type owl:NamedIndividual ,
                          :Dish ;
                 :hasIngredient :Butter ,
                                :Cheese ,
                                :Egg ;
                 :satisfiesDiet :Halal ,
                                :Kosher ,
                                :Pescatarian ,
                                :Vegetarian ;
                 :gramsOfCarbs 2 ;
                 :gramsOfFat 28 ;
                 :gramsOfProtein 22 ;
                 :hasName "Cheese Omelette" .


###  http://example.org/kr25/restaurant#Chicken_Halal
:Chicken_Halal rdf:type owl:NamedIndividual ,
                        :Ingredient ;
               :ingredientCategory :Poultry_Category ;
               :slaughterMethod :Halal_Slaughter ;
               :hasName "Chicken (halal)" .


###  http://example.org/kr25/restaurant#Chicken_Kosher
:Chicken_Kosher rdf:type owl:NamedIndividual ,
                         :Ingredient ;
                :ingredientCategory :Poultry_Category ;
                :slaughterMethod :Kosher_Slaughter ;
                :hasName "Chicken (kosher)" .


###  http://example.org/kr25/restaurant#Chickpea_Curry
:Chickpea_Curry rdf:type owl:NamedIndividual ,
                         :Dish ;
                :hasIngredient :Chickpeas ,
                               :Olive_Oil ,
                               :Rice ,
                               :Tomato ;
                :satisfiesDiet :Halal ,
                               :Kosher ,
                               :Pescatarian ,
                               :Vegan ,
                               :Vegetarian ;
                :gramsOfCarbs 55 ;
                :gramsOfFat 9 ;
                :gramsOfProtein 14 ;
                :hasName "Chickpea Curry" .


###  http://example.org/kr25/restaurant#Chickpeas
:Chickpeas rdf:type owl:NamedIndividual ,
