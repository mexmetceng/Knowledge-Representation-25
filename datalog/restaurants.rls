% Category taxonomy (facts)
animal_category(dairy).   animal_category(egg).      animal_category(honey).
animal_category(poultry). animal_category(beef).     animal_category(lamb).
animal_category(pork).    animal_category(fish).     animal_category(shellfish).
meat_category(poultry).   meat_category(beef).       meat_category(lamb).
meat_category(pork).
seafood_category(fish).   seafood_category(shellfish).

% ---------------------------------------------------------------------
% PROGRAM P (rules)
% ---------------------------------------------------------------------

% Projection
is_restaurant(?r) :- restaurant(?r, ?n, ?t, ?c).
is_dish(?d) :- dish(?d, ?n, ?p, ?c, ?f).
serves(?r, ?d) :- menu(?r, ?d, ?tier).
has_cheap_option(?r) :- menu(?r, ?d, cheap).

% Join: categories and allergens of a dish
dish_category(?d, ?c) :- dish_ingredient(?d, ?i), ingredient(?i, ?n, ?c).
dish_allergen(?d, ?a) :- dish_ingredient(?d, ?i), allergen(?i, ?a).

% Dish content
contains_meat(?d)    :- dish_category(?d, ?c), meat_category(?c).
contains_seafood(?d) :- dish_category(?d, ?c), seafood_category(?c).
contains_animal_product(?d) :- dish_category(?d, ?c), animal_category(?c).

% Diet violations. Two rules with the same head express disjunction.
% Positive Datalog has no negation, so "suitable for" is not expressed.
not_vegan(?d)       :- contains_animal_product(?d).
not_vegetarian(?d)  :- contains_meat(?d).
not_vegetarian(?d)  :- contains_seafood(?d).
not_pescatarian(?d) :- contains_meat(?d).

not_halal(?d) :- dish_category(?d, pork).
not_halal(?d) :- dish_category(?d, alcohol).

not_kosher(?d) :- dish_category(?d, pork).
not_kosher(?d) :- dish_category(?d, shellfish).
not_kosher(?d) :- contains_meat(?d), dish_category(?d, dairy).

halal_meat_dish(?d)  :- dish_ingredient(?d, ?i), slaughter(?i, halal).
kosher_meat_dish(?d) :- dish_ingredient(?d, ?i), slaughter(?i, kosher).

% Restaurant level (A ⊓ ∃r.B ⊑ C pattern)
serves_allergen(?r, ?a)  :- serves(?r, ?d), dish_allergen(?d, ?a).
serves_meat(?r)          :- serves(?r, ?d), contains_meat(?d).
serves_seafood(?r)       :- serves(?r, ?d), contains_seafood(?d).
serves_alcohol(?r)       :- serves(?r, ?d), dish_category(?d, alcohol).
serves_halal_meat(?r)    :- serves(?r, ?d), halal_meat_dish(?d).
serves_kosher_meat(?r)   :- serves(?r, ?d), kosher_meat_dish(?d).
pet_friendly_public(?r)  :- public_access(?r, true), pets_allowed(?r, true).
not_public(?r)           :- public_access(?r, false).

% ---------------------------------------------------------------------
% INTEGRITY CONSTRAINTS
% Nemo has no ⊥, so a special predicate shows each violation.
%   ⊥ <- slaughter(I, halal) ∧ slaughter(I, kosher)
%   ⊥ <- menu(R, D, cheap) ∧ menu(R, D, expensive)   (same for the other pairs)
% ---------------------------------------------------------------------
violation_slaughter(?i)  :- slaughter(?i, halal), slaughter(?i, kosher).
violation_price(?r, ?d)  :- menu(?r, ?d, cheap), menu(?r, ?d, expensive).
violation_price(?r, ?d)  :- menu(?r, ?d, cheap), menu(?r, ?d, medium).
violation_price(?r, ?d)  :- menu(?r, ?d, medium), menu(?r, ?d, expensive).

% Output (Nemo: show these predicates)
@output not_vegan.
@output not_vegetarian.
@output not_halal.
@output not_kosher.
@output serves_allergen.
@output violation_slaughter.
@output violation_price.
